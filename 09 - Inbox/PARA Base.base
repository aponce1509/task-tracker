filters:
  and:
    - paras.contains(this.file)
views:
  - type: table
    name: All notes
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178
  - type: table
    name: Inbox
    filters:
      and:
        - file.tags.contains("inbox")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178
  - type: table
    name: Consumibles
    filters:
      and:
        - file.tags.contains("_consumibles")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178
  - type: table
    name: Logs
    filters:
      and:
        - file.tags.contains("_logs")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178
  - type: table
    name: Capture
    filters:
      and:
        - file.tags.contains("_captures")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178
  - type: table
    name: Resources
    filters:
      and:
        - file.tags.contains("_resources")
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - tags
      - rate
      - paras
    columnSize:
      file.name: 185
      note.paras: 178

