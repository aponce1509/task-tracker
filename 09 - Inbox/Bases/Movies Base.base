filters:
  and:
    - categories.contains(link("Movies"))
views:
  - type: table
    name: Table
    filters:
      and:
        - categories.contains(link("Movies"))
    order:
      - file.name
      - cover
  - type: cards
    name: View
    order:
      - file.name
      - plot
    image: note.cover
    cardSize: 120
