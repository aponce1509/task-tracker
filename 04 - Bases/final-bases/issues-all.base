filters:
  and:
    - '!file.name.contains("Issues - Template")'
    - type == link("Issues")
views:
  - type: table
    name: Complete View
    filters:
      and:
        - status != "done"
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Complete Backlog
    filters:
      or:
        - status == ""
        - status.isEmpty()
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Complete Inbox
    filters:
      and:
        - status == "inbox"
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Complete WIP
    filters:
      and:
        - status == "wip"
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Complete Blocked
    filters:
      and:
        - status == "blocked"
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - dueDate
    sort:
      - property: file.name
        direction: ASC
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
