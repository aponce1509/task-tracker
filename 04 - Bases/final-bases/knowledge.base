    columnSize:
      file.name: 284
      note.learning_status: 100
      note.maturity: 101
      note.status: 94
  - type: table
    name: Annotations
    filters:
      and:
        - type == link("Annotations")
    groupBy:
      property: subtypes
      direction: ASC
    order:
      - file.name
      - learning_status
      - maturity
      - status
      - winstreak
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 284
      note.learning_status: 100
      note.maturity: 101
      note.status: 94
