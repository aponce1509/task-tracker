        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Incident
    filters:
      and:
        - status != "done"
        - subtypes.contains(link("Operational - Issues - incident"))
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 322
      note.priority: 57
      note.dueDate: 132
  - type: table
    name: Open Problem
    filters:
      and:
        - status != "done"
        - subtypes.contains(link("Operational - Issues - open-problem"))
    groupBy:
      property: paras
      direction: ASC
    order:
      - file.name
      - status
      - dueDate
    sort:
      - property: priority
        direction: ASC
      - property: dueDate
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 322
