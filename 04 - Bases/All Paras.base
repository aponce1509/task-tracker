filters:
  and:
    - file_class == ["par"]
views:
  - type: cards
    name: Table
    groupBy:
      property: paraType
      direction: ASC
    order:
      - file.name
      - priority
      - dueDate
      - paras
    sort:
      - property: priority
        direction: DESC
      - property: dueDate
        direction: ASC
    columnSize:
      file.name: 282
    image: note.img
  - type: table
    name: Projects
  - type: table
    name: Areas
  - type: table
    name: Resources
  - type: table
    name: Archive
